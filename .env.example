# ==============================================================================
# ChatSpace - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to create your local environment configurations:
#   - server/.env (Backend server configurations)
#   - client/.env (Frontend Vite environment variables, if hosted separately)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (server/.env)
# ------------------------------------------------------------------------------

# Port the backend server will listen on (Render / Heroku / Railway assign this dynamically)
PORT=5000

# Environment mode: 'development' or 'production'
NODE_ENV=development

# Cryptographically strong secret key used for JWT signing and verification
JWT_SECRET=chatspace_super_secret_jwt_key_change_in_production_min32chars

# MongoDB Atlas or Local connection URI
# If omitted or unavailable, ChatSpace automatically falls back to its built-in high-performance in-memory store
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/chatspace?retryWrites=true&w=majority

# Client origin for CORS (allowed origins).
# For local development with Vite: http://localhost:5173
# For unified production deployment (Render single-service): leave blank
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Configuration (client/.env)
# ------------------------------------------------------------------------------

# Only required if deploying the Frontend separately (e.g., on Vercel, Netlify, or Cloudflare Pages)
# If left blank, the frontend dynamically communicates with its host origin.
VITE_API_URL=
VITE_SOCKET_URL=
