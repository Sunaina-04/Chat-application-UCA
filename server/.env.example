# Server Port (Render / Railway assign PORT automatically)
PORT=5000

# Environment Mode: development or production
NODE_ENV=production

# Cryptographically generated 256-bit JWT Secret Key
JWT_SECRET=

# MongoDB Atlas connection string for cluster0
MONGODB_URI=

# Client URL for CORS (Leave blank if deploying full-stack on Render)
CLIENT_URL=

# Comma-separated list of additional allowed CORS origins
ALLOWED_ORIGINS=

# Optional: Vercel project name to scope preview deploy URLs (e.g., chat-application-uca)
VERCEL_PROJECT_NAME=

# Optional: Password for demo accounts in development (randomly generated if omitted)
DEMO_USER_PASSWORD=

# Enable 1-click demo login in production (default: false)
ENABLE_DEMO_ACCOUNTS=false
